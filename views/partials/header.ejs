<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Approval-based temporary access for GitHub and AWS. Open source. Self hosted.">
<title>
<%= title %> · Access Harbor</title>
<link rel="icon" href="/assets/mark.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/styles.css">
<script src="/assets/app.js" defer>
</script>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<header class="topbar">
<a class="brand" href="<%= user ? '/' : '/login' %>">
<img src="/assets/mark.svg" width="30" height="30" alt="">Access Harbor<span class="version">v0.1</span>
</a>
<nav aria-label="Main navigation">
<a href="/integration-guide">Integration guide</a>
<% if(user) { %>
<a class="<%= currentPath==='/' ? 'selected' : '' %>" href="/">My access</a>
<% if(admin) { %>
<a class="<%= currentPath==='/approvals' ? 'selected' : '' %>" href="/approvals">Review requests</a>
<a class="<%= currentPath==='/setup' ? 'selected' : '' %>" href="/setup">Setup</a>
<% } %>
<% } %>
<a class="<%= currentPath==='/guide' ? 'selected' : '' %>" href="/guide">How it works</a>
</nav>
<% if(user) { %>
<div class="account">
<span>
<%= user.name %>
<small>
<%= admin ? 'Administrator' : 'Member' %>
</small>
</span>
<form method="post" action="/logout">
<input type="hidden" name="csrf" value="<%= csrf %>">
<button class="quiet" title="Sign out">Sign out</button>
</form>
</div>
<% } else { %>
<a class="quiet" href="/login">Sign in →</a>
<% } %>
</header>
<main id="main" class="shell <%= typeof narrow!=='undefined' && narrow ? 'narrow' : '' %>">
<% if(flash) { %>
<div class="alert success" role="status">
<%= flash.message %>
</div>
<% } %>
