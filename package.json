{
  "name": "access-harbor",
  "version": "0.1.0",
  "description": "Open-source, approval-based temporary access for GitHub and AWS.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "format": "prettier --write \"{src,scripts,public,tests}/**/*.{js,css}\" package.json",
    "format:check": "prettier --check \"{src,scripts,public,tests}/**/*.{js,css}\" package.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-identitystore": "^3.1152.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sso-admin": "^3.900.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "nodemailer": "^10.1.2",
    "openid-client": "^6.8.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
